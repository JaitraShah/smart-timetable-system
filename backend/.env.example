# Copy to .env and adjust for your MySQL install.
PORT=4000
NODE_ENV=development

# MySQL connection (local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
# Must match a database you created in MySQL (see ../sql/create_database.sql)
DB_NAME=smart_timetable

# JWT secret — use any long random string locally
JWT_SECRET=change-this-to-a-long-random-string-for-local-dev-only

# Plain-text passwords are stored in DB for this academic demo only — see README.
# INSECURE: never use this pattern in production.

# Where uploaded files are stored (absolute or relative to backend cwd)
UPLOAD_DIR=../uploads

# Public URL prefix for uploaded files (served by Express)
UPLOAD_PUBLIC_PATH=/uploads
